<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/rootLayout"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/black">

	<WebView
		android:id="@+id/webView"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:visibility="gone" />

	<ScrollView
		android:id="@+id/startPanel"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="@color/black"
		android:fillViewport="true">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_horizontal"
			android:orientation="vertical"
			android:padding="32dp">

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginBottom="16dp"
				android:text="@string/app_name"
				android:textColor="#FFFFFF"
				android:textSize="28sp"
				android:textStyle="bold" />

			<ImageView
				android:id="@+id/qrCodeImage"
				android:layout_width="200dp"
				android:layout_height="200dp"
				android:layout_marginBottom="16dp"
				android:background="#FFFFFF"
				android:contentDescription="@string/qr_content_desc"
				android:padding="8dp"
				android:scaleType="fitCenter" />

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginBottom="4dp"
				android:text="@string/controller_url_label"
				android:textColor="@color/deskreen_text_secondary"
				android:textSize="12sp"
				android:textAllCaps="true"
				android:letterSpacing="0.08" />

			<TextView
				android:id="@+id/controllerUrlText"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginBottom="12dp"
				android:gravity="center"
				android:textColor="@color/deskreen_text_primary"
				android:textIsSelectable="true"
				android:textSize="14sp" />

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginBottom="4dp"
				android:text="@string/api_url_label"
				android:textColor="@color/deskreen_text_secondary"
				android:textSize="12sp"
				android:textAllCaps="true"
				android:letterSpacing="0.08" />

			<TextView
				android:id="@+id/hostInfoText"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginBottom="12dp"
				android:gravity="center"
				android:textColor="@color/deskreen_text_secondary"
				android:textIsSelectable="true"
				android:textSize="13sp" />

			<TextView
				android:id="@+id/statusText"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginBottom="8dp"
				android:gravity="center"
				android:textColor="#CCCCCC"
				android:textSize="13sp" />

			<TextView
				android:id="@+id/errorText"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginBottom="16dp"
				android:gravity="center"
				android:textColor="#F87171"
				android:textSize="13sp"
				android:visibility="gone" />

			<TextView
				android:id="@+id/youtubeAccountText"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginBottom="12dp"
				android:gravity="center"
				android:textColor="#FACC15"
				android:textSize="14sp" />

			<com.google.android.material.button.MaterialButton
				android:id="@+id/signInYouTubeButton"
				style="@style/Widget.MaterialComponents.Button.OutlinedButton"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginBottom="12dp"
				android:text="@string/sign_in_youtube" />

			<com.google.android.material.button.MaterialButton
				android:id="@+id/copyUrlButton"
				style="@style/Widget.MaterialComponents.Button.OutlinedButton"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginBottom="16dp"
				android:text="@string/copy_url" />

			<com.google.android.material.button.MaterialButton
				android:id="@+id/startShowButton"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginBottom="16dp"
				android:text="@string/start_show" />

			<LinearLayout
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginEnd="12dp"
					android:text="@string/auto_start_boot"
					android:textColor="#AAAAAA"
					android:textSize="14sp" />

				<Switch
					android:id="@+id/autoBootSwitch"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:showText="false" />
			</LinearLayout>
		</LinearLayout>
	</ScrollView>
</FrameLayout>
