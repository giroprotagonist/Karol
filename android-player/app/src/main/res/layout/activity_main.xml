<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/rootLayout"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:animateLayoutChanges="false">

	<!-- WebView fills the screen — bottom margin pushed up by controls in windowed mode -->
	<WebView
		android:id="@+id/webView"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="@null"
		android:visibility="gone" />

	<!-- ExoPlayer view for local video playback (hidden until local file is ready) -->
	<androidx.media3.ui.PlayerView
		android:id="@+id/playerView"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="#000000"
		android:visibility="gone"
		app:use_controller="false"
		app:surface_type="surface_view"
		app:resize_mode="fit" />

	<!-- Controls panel — sits at the bottom, fixed 200dp height -->
	<LinearLayout
		android:id="@+id/controlsPanel"
		android:layout_width="match_parent"
		android:layout_height="200dp"
		android:layout_gravity="bottom"
		android:background="#E8101018"
		android:clickable="true"
		android:focusable="true"
		android:orientation="vertical"
		android:padding="12dp"
		android:visibility="gone">

		<!-- Seek bar row -->
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_vertical"
			android:orientation="horizontal">

			<TextView
				android:id="@+id/ctlCurrentTime"
				android:layout_width="48dp"
				android:layout_height="wrap_content"
				android:gravity="center"
				android:text="0:00"
				android:textColor="@color/karol_text_secondary"
				android:textSize="12sp" />

			<SeekBar
				android:id="@+id/ctlSeekBar"
				android:layout_width="0dp"
				android:layout_height="24dp"
				android:layout_marginStart="4dp"
				android:layout_marginEnd="4dp"
				android:layout_weight="1"
				android:max="1000"
				android:progressTint="@color/karol_accent"
				android:thumbTint="@color/karol_accent" />

			<TextView
				android:id="@+id/ctlTotalTime"
				android:layout_width="48dp"
				android:layout_height="wrap_content"
				android:gravity="center"
				android:text="0:00"
				android:textColor="@color/karol_text_secondary"
				android:textSize="12sp" />
		</LinearLayout>

		<!-- Button row -->
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="4dp"
			android:gravity="center"
			android:orientation="horizontal">

			<com.google.android.material.button.MaterialButton
				android:id="@+id/ctlPrev"
				style="@style/Widget.MaterialComponents.Button.TextButton"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:insetLeft="0dp"
				android:insetTop="0dp"
				android:insetRight="0dp"
				android:insetBottom="0dp"
				android:minWidth="0dp"
				android:minHeight="0dp"
				android:padding="0dp"
				android:text="⏮"
				android:textColor="@color/karol_text_primary"
				android:textSize="22sp" />

			<com.google.android.material.button.MaterialButton
				android:id="@+id/ctlSkipBack"
				style="@style/Widget.MaterialComponents.Button.TextButton"
				android:layout_width="44dp"
				android:layout_height="44dp"
				android:insetLeft="0dp"
				android:insetTop="0dp"
				android:insetRight="0dp"
				android:insetBottom="0dp"
				android:minWidth="0dp"
				android:minHeight="0dp"
				android:padding="0dp"
				android:text="↩10"
				android:textColor="@color/karol_text_secondary"
				android:textSize="12sp" />

			<com.google.android.material.button.MaterialButton
				android:id="@+id/ctlPlayPause"
				style="@style/Widget.MaterialComponents.Button.TextButton"
				android:layout_width="56dp"
				android:layout_height="56dp"
				android:insetLeft="0dp"
				android:insetTop="0dp"
				android:insetRight="0dp"
				android:insetBottom="0dp"
				android:minWidth="0dp"
				android:minHeight="0dp"
				android:padding="0dp"
				android:text="▶"
				android:textColor="@color/karol_accent"
				android:textSize="28sp" />

			<com.google.android.material.button.MaterialButton
				android:id="@+id/ctlSkipFwd"
				style="@style/Widget.MaterialComponents.Button.TextButton"
				android:layout_width="44dp"
				android:layout_height="44dp"
				android:insetLeft="0dp"
				android:insetTop="0dp"
				android:insetRight="0dp"
				android:insetBottom="0dp"
				android:minWidth="0dp"
				android:minHeight="0dp"
				android:padding="0dp"
				android:text="↪10"
				android:textColor="@color/karol_text_secondary"
				android:textSize="12sp" />

			<com.google.android.material.button.MaterialButton
				android:id="@+id/ctlNext"
				style="@style/Widget.MaterialComponents.Button.TextButton"
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:insetLeft="0dp"
				android:insetTop="0dp"
				android:insetRight="0dp"
				android:insetBottom="0dp"
				android:minWidth="0dp"
				android:minHeight="0dp"
				android:padding="0dp"
				android:text="⏭"
				android:textColor="@color/karol_text_primary"
				android:textSize="22sp" />

			<View
				android:layout_width="16dp"
				android:layout_height="1dp" />

			<com.google.android.material.button.MaterialButton
				android:id="@+id/ctlCC"
				style="@style/Widget.MaterialComponents.Button.TextButton"
				android:layout_width="44dp"
				android:layout_height="44dp"
				android:insetLeft="0dp"
				android:insetTop="0dp"
				android:insetRight="0dp"
				android:insetBottom="0dp"
				android:minWidth="0dp"
				android:minHeight="0dp"
				android:padding="0dp"
				android:text="CC"
				android:textColor="@color/karol_text_secondary"
				android:textSize="14sp"
				android:textStyle="bold" />

			<com.google.android.material.button.MaterialButton
				android:id="@+id/ctlQueue"
				style="@style/Widget.MaterialComponents.Button.TextButton"
				android:layout_width="44dp"
				android:layout_height="44dp"
				android:insetLeft="0dp"
				android:insetTop="0dp"
				android:insetRight="0dp"
				android:insetBottom="0dp"
				android:minWidth="0dp"
				android:minHeight="0dp"
				android:padding="0dp"
				android:text="☰"
				android:textColor="@color/karol_text_secondary"
				android:textSize="20sp" />
		</LinearLayout>
	</LinearLayout>

	<!-- Toggle FAB — always visible during show -->
	<ImageButton
		android:id="@+id/toggleFullscreenBtn"
		android:layout_width="48dp"
		android:layout_height="48dp"
		android:layout_gravity="top|end"
		android:layout_margin="8dp"
		android:background="#88000000"
		android:contentDescription="Toggle fullscreen"
		android:elevation="20dp"
		android:scaleType="centerInside"
		android:src="@android:drawable/ic_menu_crop"
		android:visibility="gone"
		android:padding="8dp" />

	<FrameLayout
		android:id="@+id/loadingOverlay"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="@color/black"
		android:clickable="true"
		android:elevation="100dp"
		android:focusable="true"
		android:visibility="gone"
		android:alpha="0">

		<ProgressBar
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:layout_gravity="center"
			android:indeterminate="true"
			android:indeterminateTint="@color/karol_accent" />
	</FrameLayout>

	<ScrollView
		android:id="@+id/startPanel"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="@color/black"
		android:fillViewport="true">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_horizontal"
			android:orientation="vertical"
			android:padding="32dp">

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginBottom="16dp"
				android:text="@string/app_name"
				android:textColor="#FFFFFF"
				android:textSize="28sp"
				android:textStyle="bold" />

			<ImageView
				android:id="@+id/qrCodeImage"
				android:layout_width="200dp"
				android:layout_height="200dp"
				android:layout_marginBottom="16dp"
				android:background="#FFFFFF"
				android:contentDescription="@string/qr_content_desc"
				android:padding="8dp"
				android:scaleType="fitCenter" />

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginBottom="4dp"
				android:text="@string/controller_url_label"
				android:textColor="@color/karol_text_secondary"
				android:textSize="12sp"
				android:textAllCaps="true"
				android:letterSpacing="0.08" />

			<TextView
				android:id="@+id/controllerUrlText"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginBottom="12dp"
				android:gravity="center"
				android:textColor="@color/karol_text_primary"
				android:textIsSelectable="true"
				android:textSize="14sp" />

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginBottom="4dp"
				android:text="@string/api_url_label"
				android:textColor="@color/karol_text_secondary"
				android:textSize="12sp"
				android:textAllCaps="true"
				android:letterSpacing="0.08" />

			<TextView
				android:id="@+id/hostInfoText"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginBottom="12dp"
				android:gravity="center"
				android:textColor="@color/karol_text_secondary"
				android:textIsSelectable="true"
				android:textSize="13sp" />

			<TextView
				android:id="@+id/statusText"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginBottom="8dp"
				android:gravity="center"
				android:textColor="#CCCCCC"
				android:textSize="13sp" />

			<TextView
				android:id="@+id/errorText"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginBottom="16dp"
				android:gravity="center"
				android:textColor="#F87171"
				android:textSize="13sp"
				android:visibility="gone" />

			<TextView
				android:id="@+id/youtubeAccountText"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginBottom="12dp"
				android:gravity="center"
				android:textColor="#FACC15"
				android:textSize="14sp" />

			<com.google.android.material.button.MaterialButton
				android:id="@+id/signInYouTubeButton"
				style="@style/Widget.MaterialComponents.Button.OutlinedButton"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginBottom="4dp"
				android:text="@string/sign_in_youtube" />

			<TextView
				android:id="@+id/signInTroubleLink"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginBottom="12dp"
				android:padding="8dp"
				android:text="@string/sign_in_trouble_import"
				android:textColor="@color/karol_text_secondary"
				android:textSize="12sp" />

			<com.google.android.material.button.MaterialButton
				android:id="@+id/copyUrlButton"
				style="@style/Widget.MaterialComponents.Button.OutlinedButton"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginBottom="16dp"
				android:text="@string/copy_url" />

			<com.google.android.material.button.MaterialButton
				android:id="@+id/startShowButton"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginBottom="16dp"
				android:text="@string/start_show" />

			<LinearLayout
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginEnd="12dp"
					android:text="@string/auto_start_boot"
					android:textColor="#AAAAAA"
					android:textSize="14sp" />

				<Switch
					android:id="@+id/autoBootSwitch"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:showText="false" />
			</LinearLayout>
		</LinearLayout>
	</ScrollView>

	<LinearLayout
		android:id="@+id/reauthOverlay"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="#CC000000"
		android:gravity="center"
		android:orientation="vertical"
		android:padding="32dp"
		android:visibility="gone">

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:gravity="center"
			android:text="@string/reauth_overlay_message"
			android:textColor="@color/karol_text_primary"
			android:textSize="18sp" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/reauthButton"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="24dp"
			android:text="@string/reauth_button" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/reauthStopShowButton"
			style="@style/Widget.MaterialComponents.Button.TextButton"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:text="@string/stop_show" />
	</LinearLayout>

	<!-- Sign-in progress banner -->
	<FrameLayout
		android:id="@+id/signInProgressOverlay"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_gravity="top"
		android:visibility="gone">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:background="#CC000000"
			android:gravity="center"
			android:orientation="vertical"
			android:paddingTop="24dp"
			android:paddingBottom="16dp"
			android:paddingStart="24dp"
			android:paddingEnd="24dp">

			<LinearLayout
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<ProgressBar
					android:id="@+id/signInSpinner"
					android:layout_width="24dp"
					android:layout_height="24dp"
					android:layout_marginEnd="12dp"
					android:indeterminate="true"
					android:indeterminateTint="@color/karol_accent" />

				<TextView
					android:id="@+id/signInProgressTitle"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:text="@string/sign_in_overlay_opening"
					android:textColor="@color/karol_text_primary"
					android:textSize="16sp"
					android:textStyle="bold" />
			</LinearLayout>

			<TextView
				android:id="@+id/signInProgressSubtitle"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="6dp"
				android:gravity="center"
				android:text="@string/sign_in_overlay_2fa_hint"
				android:textColor="@color/karol_text_secondary"
				android:textSize="13sp" />

			<LinearLayout
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="12dp"
				android:gravity="center"
				android:orientation="horizontal">

				<com.google.android.material.button.MaterialButton
					android:id="@+id/signInRetryButton"
					style="@style/Widget.MaterialComponents.Button.OutlinedButton"
					android:layout_width="wrap_content"
					android:layout_height="36dp"
					android:layout_marginEnd="12dp"
					android:text="@string/sign_in_overlay_timeout"
					android:textSize="13sp"
					android:visibility="gone" />

				<com.google.android.material.button.MaterialButton
					android:id="@+id/signInCancelButton"
					style="@style/Widget.MaterialComponents.Button.TextButton"
					android:layout_width="wrap_content"
					android:layout_height="36dp"
					android:text="@string/sign_in_overlay_cancel"
					android:textSize="13sp" />
			</LinearLayout>
		</LinearLayout>
	</FrameLayout>
</FrameLayout>
