{
  "name": "deskreen-ce",
  "version": "1.0.0",
  "description": "Screen sharing and present screen: Turn any device into a secondary screen for your computer",
  "main": "./out/main/index.js",
  "author": "deskreen.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "clean": "rm -rf dist out src/client-viewer/dist src/dj-controller/dist",
    "format": "biome format --write . --max-diagnostics=none",
    "lint": "biome lint . --max-diagnostics=none",
    "lint:error-only": "biome lint --write . --max-diagnostics=none --diagnostic-level=error",
    "typecheck:client-viewer": "tsc --noEmit -p src/client-viewer/tsconfig.app.json --composite false",
    "typecheck:dj-controller": "tsc --noEmit -p src/dj-controller/tsconfig.json --composite false",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:client-viewer && npm run typecheck:dj-controller && npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "concurrently \"electron-vite dev\" \"npm run devClientViewer\"",
    "devClientViewer": "cd src/client-viewer && npm run dev -- --host --port=5174",
    "devDjController": "cd src/dj-controller && npm run dev -- --host --port=5175",
    "buildDev": "npm run buildClientViewer && npm run buildDjController && electron-vite build",
    "build": "npm run typecheck && npm run buildClientViewer && npm run buildDjController && electron-vite build",
    "buildClientViewer": "cd src/client-viewer && npm run build",
    "buildDjController": "cd src/dj-controller && npm run build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:win:ia32": "npm run build && electron-builder --win --ia32",
    "build:win:arm64": "npm run build && electron-builder --win --arm64",
    "build:mac": "npm run buildClientViewer && npm run buildDjController && electron-vite build && electron-builder --mac",
    "build:mac:arm64": "npm run buildClientViewer && npm run buildDjController && electron-vite build && electron-builder --mac --arm64",
    "build:mac:x64": "npm run buildClientViewer && npm run buildDjController && electron-vite build && electron-builder --mac --x64",
    "build:linux": "npm run buildClientViewer && electron-vite build && electron-builder --linux",
    "build:linux:arm64": "npm run buildClientViewer && electron-vite build && electron-builder --linux --arm64",
    "build:linux:armv7l": "npm run buildClientViewer && electron-vite build && electron-builder --linux --armv7l",
    "verify:cast": "bash scripts/verify-cast-e2e.sh",
    "verify:cast:quick": "QUICK=1 bash scripts/verify-cast-e2e.sh",
    "verify:cast:webview": "CLIENT_MODE=webview bash scripts/verify-cast-e2e.sh",
    "verify:cast:webview:quick": "QUICK=1 CLIENT_MODE=webview bash scripts/verify-cast-e2e.sh",
    "verify:dj-stack": "bash scripts/verify-dj-stack.sh",
    "verify:quit": "bash scripts/verify-deskreen-quit.sh",
    "verify:quit:popout": "bash scripts/verify-deskreen-quit-with-popout.sh",
    "verify:wifi-blip": "bash scripts/verify-wifi-blip.sh",
    "verify:player-direct": "bash scripts/verify-player-direct.sh",
    "verify:s24-s8": "bash scripts/verify-s24-s8-ecosystem.sh",
    "verify:s24-s8:pairing": "bash scripts/verify-s24-s8-pairing.sh",
    "verify:s24-s8:connection": "bash scripts/verify-s24-s8-connection.sh",
    "verify:s24-volume": "bash scripts/verify-s24-volume-proxy.sh",
    "install:android": "bash scripts/install-android-devices.sh",
    "player:save-youtube-session": "bash scripts/player-youtube-session-save.sh",
    "player:restore-youtube-session": "bash scripts/player-youtube-session-restore.sh",
    "sync:dj-controller-player": "bash scripts/sync-dj-controller-to-player.sh",
    "build:android-player": "bash scripts/sync-dj-controller-to-player.sh && cd android-player && ./gradlew assembleDebug",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@blueprintjs/core": "^6.3.4",
    "@blueprintjs/select": "^6.0.8",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@material-ui/core": "^4.12.4",
    "@roamhq/wrtc": "^0.9.1",
    "@types/lodash": "^4.17.20",
    "axios": "^1.13.2",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "detect-port": "^2.1.0",
    "electron-devtools-installer": "^4.0.0",
    "electron-log": "^5.4.3",
    "electron-settings": "^4.0.4",
    "electron-store": "^10.1.0",
    "electron-updater": "^6.6.2",
    "fontsource-lexend-peta": "^4.0.0",
    "fs-extra": "^11.3.2",
    "get-port": "^7.1.0",
    "i18next": "^25.6.2",
    "i18next-fs-backend": "^2.6.0",
    "i18next-sync-fs-backend": "^1.1.1",
    "kcors": "^2.2.2",
    "koa": "^3.1.1",
    "koa-bodyparser": "^4.4.1",
    "koa-router": "^14.0.0",
    "koa-send": "^5.0.1",
    "koa-static": "^5.0.0",
    "lodash": "^4.17.21",
    "node-forge": "^1.3.1",
    "normalize.css": "^8.0.1",
    "qrcode.react": "^4.2.0",
    "react-flexbox-grid": "^2.1.2",
    "react-toast-notifications": "^2.5.1",
    "shortid": "^2.2.17",
    "simple-peer": "^9.11.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.6",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/electron-devtools-installer": "^4.0.0",
    "@types/i18next-node-fs-backend": "^2.1.5",
    "@types/kcors": "^2.2.9",
    "@types/koa": "^3.0.1",
    "@types/koa-router": "^7.4.9",
    "@types/koa-send": "^4.1.6",
    "@types/koa-static": "^4.0.4",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode.react": "^3.0.0",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.2",
    "@types/react-toast-notifications": "^2.4.1",
    "@types/simple-peer": "^9.11.9",
    "@types/socket.io": "^3.0.2",
    "@types/socket.io-client": "^3.0.0",
    "@vercel/blob": "^2.0.0",
    "@vitejs/plugin-react": "5.1.1",
    "concurrently": "^9.2.1",
    "electron": "^37.9.0",
    "electron-builder": "^26.7.0",
    "electron-vite": "^4.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^15.7.4",
    "typescript": "^5.9.3",
    "vite": "7.2.4"
  },
  "packageManager": "npm@10.9.0"
}
