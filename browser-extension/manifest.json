{
  "manifest_version": 3,
  "name": "Deskreen YouTube DJ",
  "version": "1.1.0",
  "description": "Send YouTube videos to Deskreen DJ/Karaoke queue",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "http://localhost:3131/*",
    "http://127.0.0.1:3131/*",
    "http://localhost:3132/*",
    "http://127.0.0.1:3132/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Send to Deskreen DJ"
  },
  "commands": {
    "send-to-deskreen": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Send current YouTube tab to Deskreen DJ"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
