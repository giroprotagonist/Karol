<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.karol.usb-keepawake</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/macdonk/Library/Application Support/karol/karol-usb-keepawake.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>StandardOutPath</key>
	<string>/tmp/karol-usb-keepawake.out</string>
	<key>StandardErrorPath</key>
	<string>/tmp/karol-usb-keepawake.err</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>KAROL_EXTERNAL_DRIVE</key>
		<string>/Volumes/maxone</string>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
</dict>
</plist>
